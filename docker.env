# Docker Development Environment
# Environment variables for development with Docker

# Database Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/placement_portal?authSource=admin

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development-secret-key-change-in-production

# Application Configuration
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=public/uploads

# Development Configuration
DEBUG=true
LOG_LEVEL=debug

# Admin Configuration (for initial setup)
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=admin123

# Security Configuration (development only)
JWT_SECRET=development-jwt-secret-key
ENCRYPTION_KEY=development-encryption-key-32-chars
